# Docker image versions — single source of truth
# Copy to .env and modify as needed: cp .env.example .env
PYTHON_VERSION=3.14.3-slim-bookworm
REDIS_VERSION=7.0.4
MARIADB_VERSION=10
NGINX_VERSION=1.27.3-alpine3.20-slim

# MTU for the compose network (default 1500). Lower it (e.g. 1400) when scored
# hosts are behind tunnels/overlays and TLS or HTTP checks hang after connect.
#DOCKER_NETWORK_MTU=1400

# Worker tool packs. The default worker is the slim "core" image (SSH, FTP,
# SMTP, DNS, HTTP, LDAP, SMB, WinRM, ...). Enable extra packs as needed:
#   COMPOSE_PROFILES=db,rdp,browser   # any subset: db (MySQL/Postgres/MSSQL),
#                                     # rdp, browser (Playwright web checks),
#                                     # adcs (AD CS Web Enrollment / certipy)
# or run one worker with everything:
#   WORKER_TARGET=full
# Checks whose pack has no worker fail with "No worker available for check
# pack ..." and show on the admin Queues page as a queue with no workers.
#COMPOSE_PROFILES=
#WORKER_TARGET=full

# Database credentials
MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_PASSWORD=CHANGEME

# Flask session signing key for the web service.
#
# Set this to a long, random value and keep it stable. If it changes every user
# is logged out; if web replicas disagree on it, sessions break across them and
# you cannot scale the web service past one container.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(64))"
#
# Uncomment the line below and paste the generated value. It is left commented
# out on purpose: an empty assignment is still an assignment, and docker compose
# would forward it into the containers as an empty string. If you leave it
# commented out, the value in engine.conf is used instead; if that is empty too,
# the web app generates a throwaway key per process and logs a warning, which is
# only appropriate for local development.
#SCORINGENGINE_SECRET_KEY=
